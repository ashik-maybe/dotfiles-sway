{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 5,

  // Modern Minimalist Laptop Layout
  "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad", "sway/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "idle_inhibitor",
    "pulseaudio",
    "backlight",
    "network",
    "cpu",
    "memory",
    "temperature",
    "battery",
    "battery#bat2",
    "tray"
  ],

  // --- Left Section Modules ---
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "",      // Terminal
      "2": "󰨞",      // Code / IDE
      "3": "󰈹",      // Web Browser / Docs
      "4": "󰙯",      // Communication / Chat
      "5": "󰓓",      // Entertainment / Music
      "urgent": "󱈸",
      "focused": "",
      "default": ""
    }
  },

  "sway/window": {
    "format": "󰣆  {title}",
    "max-length": 40,
    "rewrite": {
      "(.*) — Mozilla Firefox": "󰈹  $1",
      "(.*) - Visual Studio Code": "󰨞  $1",
      "nsublime(.*)": "  Neovim",
      "~(.*)": "  Terminal"
    }
  },

  "sway/mode": {
    "format": "󰘳 <span style=\"italic\">{}</span>"
  },

  "sway/scratchpad": {
    "format": "󰖯 {count}",
    "show-empty": false
  },

  // --- Center Section Module (The Visual Anchor) ---
  "clock": {
    "interval": 60,
    "format": "󰃭 {:%a %b %d}  󰥔 {:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months":    "<span color='#ffead3'><b>{}</b></span>",
        "days":      "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks":     "<span color='#99ff99'><b>W{}</b></span>",
        "weekdays":  "<span color='#ffcc66'><b>{}</b></span>",
        "today":     "<span color='#ff6666'><b><u>{}</u></b></span>"
      }
    }
  },

  // --- Right Section Modules (Laptop & Developer Utilities) ---
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰛟",   // Steaming Coffee Cup (Caffeine On)
      "deactivated": "󾠗" // Outlined/Empty Coffee Cup (Caffeine Off)
    }
  },

  "pulseaudio": {
    "format": "{icon} {volume}%  {format_source}",
    "format-bluetooth": "󰂯 {icon} {volume}%  {format_source}",
    "format-muted": "󰝟 Muted  {format_source}",
    "format-source": "󰍬 {volume}%",
    "format-source-muted": "󰍭 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "scroll-step": 5
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "scroll-step": 5
  },

  "network": {
    "format-wifi": "󰤨  {essid} 󰛴 {bandwidthDownBytes}",
    "format-ethernet": "󰈀  Wire 󰛴 {bandwidthDownBytes}",
    "format-disconnected": "󰤭  Offline",
    "interval": 2,
    "tooltip-format": "IP: {ipaddr}\nSignal: {signalStrength}%"
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 2
  },

  "memory": {
    "format": "󰍛 {used:0.1f}G/{total:0.0f}G",
    "interval": 2,
    "tooltip-format": "Swap: {swapUsed:0.1f}G / {swapTotal:0.0f}G"
  },

  "temperature": {
    "critical-threshold": 80,
    "format": " {temperatureC}°C"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {icon} {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "interval": 5
  },

  "battery#bat2": {
    "bat": "BAT2",
    "states": { "warning": 30, "critical": 15 },
    "format": "󰂄2 {capacity}%",
    "format-charging": "󱐋 󰂄2 {capacity}%"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  }
}
