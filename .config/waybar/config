{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 5,

  "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad", "sway/window"],
  "modules-center": ["mpris", "clock"],
  "modules-right": [
    "privacy",
    "bluetooth",
    "idle_inhibitor",
    "pulseaudio",
    "backlight",
    "network",
    "cpu",
    "memory",
    "temperature",
    "battery",
    "battery#bat2",
    "tray"
  ],

  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "urgent": "",
      "focused": "",
      "default": ""
    }
  },

  "sway/window": {
    "format": "  {title}",
    "max-length": 40,
    "rewrite": {
      "(.*) — Mozilla Firefox": "  $1",
      "(.*) [—-] (Chromium|Google Chrome|Brave( Browser)?|Edge|Vivaldi|Opera)$": "  $1",
      "(.*) - Visual Studio Code": "  $1",
      "(.*) - (Zed|Zed Preview)$": "  $1",
      "~(.*)": "  Terminal"
    }
  },

  "sway/mode": {
    "format": " <span style=\"italic\">{}</span>"
  },

  "sway/scratchpad": {
    "format": " {count}",
    "show-empty": false
  },

  "mpris": {
    "format": "{player_icon} {title}   {artist}",
    "format-paused": "{player_icon} {title}",
    "status-icons": {
      "playing": "",
      "paused": ""
    },
    "player-icons": {
      "default": ""
    },
    "ignored-players": ["firefox"],
    "interval": 2
  },

  "clock": {
    "interval": 60,
    "format": " {:%a %b %d}   {:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months":    "<span color='#89dceb'><b>{}</b></span>",
        "days":      "<span color='#cdd6f4'><b>{}</b></span>",
        "weeks":     "<span color='#a6e3a1'><b>W{}</b></span>",
        "weekdays":  "<span color='#f9e2af'><b>{}</b></span>",
        "today":     "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    }
  },

  "privacy": {
    "format": "{icon}",
    "icon-size": 14,
    "icon-spacing": 6,
    "privacy-items": ["camera", "microphone", "screencast"],
    "format-icons": {
      "camera": "",
      "microphone": "",
      "screencast": ""
    }
  },

  "bluetooth": {
    "format": " {num_connections}",
    "format-disabled": "",
    "format-connected": " {device_alias}",
    "on-click": "blueman-manager",
    "tooltip-format": "{device_enumerate}"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },

  "pulseaudio": {
    "format": "{icon} {volume}%  {format_source}",
    "format-bluetooth": " {icon} {volume}%  {format_source}",
    "format-muted": " Muted  {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " Muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "scroll-step": 5
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["", "", ""],
    "scroll-step": 5
  },

  "network": {
    "format-wifi": "  {essid}   {bandwidthDownBytes}",
    "format-ethernet": "  Wire   {bandwidthDownBytes}",
    "format-disconnected": "Offline",
    "interval": 2,
    "tooltip-format": "IP: {ipaddr}\nSignal: {signalStrength}%"
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 2
  },

  "memory": {
    "format": " {used:0.1f}G/{total:0.0f}G",
    "interval": 2,
    "tooltip-format": "Swap: {swapUsed:0.1f}G / {swapTotal:0.0f}G"
  },

  "temperature": {
    "critical-threshold": 85,
    "states": {
      "warning": 70
    },
    "format": " {temperatureC}°C"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": " {icon} {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "interval": 5
  },

  "battery#bat2": {
    "bat": "BAT2",
    "states": { "warning": 30, "critical": 15 },
    "format": "2 {capacity}%",
    "format-charging": " 2 {capacity}%"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  }
}
