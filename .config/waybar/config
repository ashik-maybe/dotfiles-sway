{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 4,
  "modules-left": ["custom/launcher", "sway/workspaces", "sway/mode", "sway/scratchpad", "sway/window"],
  "modules-center": ["custom/mode", "mpris", "clock"],
  "modules-right": [
    "privacy",
    "idle_inhibitor",
    "pulseaudio",
    "bluetooth",
    "network",
    "cpu",
    "memory",
    "temperature",
    "backlight",
    "battery",
    "battery#bat2",
    "tray",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "",
    "on-click": "~/.local/bin/regolith-launcher",
    "tooltip-format": "Regolith Launcher (Super+Space)"
  },

  "custom/power": {
    "format": "",
    "on-click": "~/.local/bin/regolith-power menu",
    "tooltip-format": "Power"
  },

  "custom/mode": {
    "format": " {}",
    "escape": true
  },

  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "persistent-workspaces": {
      "*": [1,2,3,4,5]
    },
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "default": "",
      "urgent": "",
      "focused": ""
    }
  },

  "sway/window": {
    "format": "{title}",
    "max-length": 50,
    "rewrite": {
      "(.*) — Mozilla Firefox": "  $1",
      "(.*) - Visual Studio Code": "  $1",
      "(.*) - (Zed|Zed Preview)$": "  $1"
    }
  },

  "sway/mode": {
    "format": " <span style=\"italic\">{}</span>"
  },

  "sway/scratchpad": {
    "format": " {count}",
    "show-empty": false
  },

  "mpris": {
    "format": "{player_icon}  {title}  {artist}",
    "format-paused": "{player_icon}  {title}",
    "status-icons": { "playing": "", "paused": "" },
    "player-icons": { "default": "" },
    "interval": 2
  },

  "clock": {
    "interval": 60,
    "format": " {:%a %b %d}   {:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },

  "privacy": {
    "format": "{icon}",
    "icon-size": 14,
    "privacy-items": ["camera", "microphone", "screencast"],
    "format-icons": { "camera": "", "microphone": "", "screencast": "" }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "", "deactivated": "" }
  },

  "pulseaudio": {
    "format": "{icon} {volume}% {format_source}",
    "format-bluetooth": " {icon} {volume}% {format_source}",
    "format-muted": " Muted {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " Muted",
    "format-icons": { "headphone": "", "hands-free": "", "headset": "", "default": ["","",""] },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "scroll-step": 5
  },

  "bluetooth": {
    "format": " {num_connections}",
    "format-disabled": "",
    "format-connected": " {device_alias}",
    "on-click": "blueman-manager"
  },

  "network": {
    "format-wifi": " {essid}  {bandwidthDownBytes}",
    "format-ethernet": " Wire  {bandwidthDownBytes}",
    "format-disconnected": "Offline",
    "interval": 2,
    "on-click": "nm-connection-editor"
  },

  "cpu": { "format": " {usage}%", "interval": 2 },
  "memory": { "format": " {used:0.1f}G/{total:0.0f}G", "interval": 2 },
  "temperature": { "format": " {temperatureC}°C", "critical-threshold": 85 },
  "backlight": { "format": "{icon} {percent}%", "format-icons": [""] },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": " {icon} {capacity}%",
    "format-icons": ["","","","",""]
  },
  "battery#bat2": {
    "bat": "BAT2",
    "format": "2 {capacity}%"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  }
}
