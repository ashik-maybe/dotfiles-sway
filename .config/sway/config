# Fedora Regolith — Proper port base (Regolith Nord look, Fedora Sway Spin)
# Upstream Regolith default look = nord (NOT Catppuccin / not Nord Gruvbox)
# Sources: regolith-linux/regolith-styles/nord/{color,theme,rofi.rasi}
# Palette: https://www.nordtheme.com

set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term foot
set $browser firefox
set $editor nvim
set $fileman nautilus

set $launcher ~/.local/bin/regolith-launcher
set $win ~/.local/bin/regolith-window
set $clip ~/.local/bin/regolith-clipboard
set $shot ~/.local/bin/regolith-screenshot
set $power ~/.local/bin/regolith-power

# --- Regolith Nord (regolith-styles/nord/color) ---
set $nord0  #2E3440
set $nord1  #3B4252
set $nord2  #434C5E
set $nord3  #4C566A
set $nord4  #D8DEE9
set $nord5  #E5E9F0
set $nord6  #ECEFF4
set $nord7  #8BC34A00
set $nord8  #8FBCBB
set $nord9  #88C0D0
set $nord10 #81A1C1
set $nord11 #5E81AC
set $nord12 #B48EAD
set $nord13 #A3BE8C
set $nord14 #EBCB8B
set $nord15 #D08770
set $nord16 #BF616A

# Back-compat aliases for waybar/rofi consumers
set $red $nord16
set $green $nord13
set $yellow $nord14
set $blue $nord10
set $cyan $nord9
set $magenta $nord12
set $orange $nord15

# --- Outputs / Wallpaper (swaybg = Fedora Sway Spin native) ---
output * bg ~/Pictures/wallpapers/regolith.png fill
output * { subpixel rgb }
exec_always swaybg -i ~/Pictures/wallpapers/regolith.png -m fill

input "type:touchpad" { dwt enabled; tap enabled; natural_scroll enabled; middle_emulation enabled; accel_profile adaptive }
input "type:keyboard" { xkb_layout us; xkb_options grp:alt_shift_toggle }
input "type:mouse" { accel_profile adaptive }

# --- Decor — Regolith tactile (nord/theme) ---
font pango:JetBrainsMono Nerd Font 9
seat seat0 xcursor_theme Arc 24
gaps inner 5
gaps outer 0
smart_gaps on
default_border pixel 1
default_floating_border normal 1
client.focused          $nord10 $nord10 $nord0 $nord9 $nord10
client.focused_inactive $nord1 $nord1 $nord4 $nord1 $nord1
client.unfocused        $nord0 $nord0 $nord3 $nord0 $nord0
client.urgent           $nord16 $nord16 $nord0 $nord16 $nord16

workspace_auto_back_and_forth yes
focus_on_window_activation smart
popup_during_fullscreen smart

# --- Staged workspaces (dev ergonomics) ---
set $ws1  "1: Code"
set $ws2  "2: Web"
set $ws3  "3: Term"
set $ws4  "4: Files"
set $ws5  "5: Comms"
set $ws6  "6"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

assign [app_id="code-oss"] $ws1
assign [class="Code"] $ws1
assign [app_id="Zed"] $ws1
assign [app_id="firefox"] $ws2
assign [app_id="foot"] $ws3
assign [app_id="org.gnome.Nautilus"] $ws4
assign [app_id="Slack"] $ws5
assign [app_id="discord"] $ws5

for_window [app_id="pavucontrol"] floating enable, resize set 700x500, move position center
for_window [window_role="pop-up"] floating enable

# --- Autostart ---
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec dunst
exec_always waybar
exec_always --no-startupid foot -s
exec_always swayidle -w timeout 300 'swaylock -f' timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep 'swaylock -f'
exec_always wl-paste --watch cliphist store

import-config.d/10-binds.conf
import-config.d/20-media.conf
import-config.d/30-autostart.conf
