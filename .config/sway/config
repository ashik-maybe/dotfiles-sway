# =============================================================================
# FEDORA REGOLITH - Sway Edition
# Regolith-style Sway for Fedora: tactile, staged workspaces + dev ergonomics
# Inspired by https://regolith-desktop.com (i3-gaps + rofi + polybar), rebuilt
# native on Sway + Waybar + Rofi + Dunst for Fedora Sway Spin.
# =============================================================================

# --- Fedora layered include (keeps Spin defaults, we override below) ---
include /etc/sway/config.d/*.conf

# =============================================================================
# VARIABLES
# =============================================================================
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term foot
set $browser firefox
set $editor nvim
set $fileman nautilus

set $launcher ~/.local/bin/regolith-launcher
set $window_switcher ~/.local/bin/regolith-window
set $clipboard ~/.local/bin/regolith-clipboard
set $power ~/.local/bin/regolith-power
set $screenshot ~/.local/bin/regolith-screenshot

# Catppuccin Mocha core (single source of truth, mirrored in other apps)
set $rosewater #f5e0dc
set $flamingo  #f2cdcd
set $pink      #f5c2e7
set $mauve     #cba6f7
set $red       #f38ba8
set $peach     #fab387
set $yellow    #f9e2af
set $green     #a6e3a1
set $teal      #94e2d5
set $sky       #89dceb
set $sapphire  #74c7ec
set $blue      #89b4fa
set $lavender  #b4befe
set $text      #cdd6f4
set $subtext0  #a6adc8
set $overlay1  #7f849c
set $overlay0  #6c7086
set $surface2  #585b70
set $surface1  #45475a
set $surface0  #313244
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b

# =============================================================================
# OUTPUTS / BACKGROUNDS / INPUTS
# =============================================================================
output * bg ~/Pictures/wallpapers/regolith.png fill
output * {
    subpixel rgb
}

input "type:touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    accel_profile adaptive
}

input "type:keyboard" {
    xkb_layout us
    xkb_options grp:alt_shift_toggle
}

input "type:mouse" {
    accel_profile adaptive
}

# =============================================================================
# FONTS / CURSOR / WINDOW DECOR
# =============================================================================
font pango:JetBrainsMono Nerd Font 9
seat seat0 xcursor_theme Catppuccin-Mocha-Dark-Cursors 24

# Regolith tactile gaps
gaps inner 8
gaps outer 0
smart_gaps on
hide_edge_borders smart

default_border pixel 2
default_floating_border normal 2
client.focused          $blue $blue $crust $lavender $blue
client.focused_inactive $surface0 $surface0 $text $surface0 $surface0
client.unfocused        $base $base $subtext0 $base $base
client.urgent           $red $red $crust $red $red

# Workspace / Focus QoL
workspace_auto_back_and_forth yes
focus_on_window_activation smart
popup_during_fullscreen smart
focus_follows_mouse yes
focus_wrapping yes

# =============================================================================
# WORKSPACE ASSIGNMENTS (staged workflow -> maximum dev ergonomics)
# 1 Code | 2 Browser | 3 Terminal | 4 Files | 5 Media/Comms | 6-0 dynamic
# Regolith stages: don't force windows, just default them where they make sense.
# =============================================================================
set $ws1  "1: Code"
set $ws2  "2: Web"
set $ws3  "3: Term"
set $ws4  "4: Files"
set $ws5  "5: Comms"
set $ws6  "6: Misc"
set $ws7  "7"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

workspace $ws1 output primary
workspace $ws2 output primary
workspace $ws3 output primary
workspace $ws4 output primary
workspace $ws5 output primary

assign [app_id="code-oss"] $ws1
assign [class="Code"] $ws1
assign [app_id="codium"] $ws1
assign [app_id="neovim"] $ws1
assign [app_id="Zed"] $ws1
assign [app_id="firefox"] $ws2
assign [app_id="Chromium"] $ws2
assign [app_id="Brave-browser"] $ws2
assign [app_id="foot"] $ws3
assign [app_id="Alacritty"] $ws3
assign [app_id="kitty"] $ws3
assign [app_id="org.gnome.Nautilus"] $ws4
assign [app_id="dolphin"] $ws4
assign [app_id="Slack"] $ws5
assign [app_id="discord"] $ws5
assign [app_id="signal"] $ws5
assign [app_id="thunderbird"] $ws5

# =============================================================================
# LAYOUT / FLOATING RULES
# =============================================================================
for_window [app_id="pavucontrol"] floating enable, resize set 700x500, move position center
for_window [app_id="blueman-manager"] floating enable, resize set 640x480
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [app_id="nm-connection-editor"] floating enable

# Scratchpad is for dev tools: live logs, test runners, scratch terminals
for_window [title="regolith-drop"] floating enable, resize set 1200x700, move position center

# =============================================================================
# AUTOSTART (Regolith session daemons)
# =============================================================================
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway
exec dunst
exec_always waybar
exec_always swayidle -w \
    timeout 300 'swaylock -f' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'
exec_always wl-paste --watch cliphist store

import-config.d/10-binds.conf
import-config.d/20-media.conf
import-config.d/30-autostart.conf
