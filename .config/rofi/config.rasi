/* ==============================================================================
 * ROFI CATPPUCCIN MOCHA LAUNCHER THEME
 * ============================================================================== */

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    display-drun:               " ";
    display-run:                " ";
    drun-format:                "{name}";
    font:                       "Arimo Nerd Font Bold 11";
    /* icon-theme:                 "Papirus-Dark"; */
}

/* --- Color Variables Matrix --- */
* {
    bg-col:      #11111b; /* Base Pitch Black */
    bg-alt:      #1e1e2e; /* Slate Capsule Base */
    border-col:  #89b4fa; /* Electric Blue Accent Line */
    text-col:    #cdd6f4; /* Crisp Soft White Text */
    text-muted:  #6c7086; /* Gray Subtext Icons */
    selected:    #313244; /* Highlight Hover Box Color */
    urgent:      #f38ba8; /* Alert Pinkish Red */

    width: 600;
    background-color: transparent;
}

/* Master Window Canvas Wrapper */
window {
    height:                      400px;
    border:                      2px;
    border-color:                @border-col;
    border-radius:               12px;
    background-color:            @bg-col;
    text-color:                  @text-col;
}

/* Main Visual Layout Grid Configuration */
mainbox {
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
    padding:                     16px;
    spacing:                     12px;
}

/* --- Top Row Search Bar Wrapper --- */
inputbar {
    background-color:            @bg-alt;
    text-color:                  @text-col;
    border-radius:               8px;
    padding:                     10px 14px;
    children:                    [ "prompt", "entry" ];
    spacing:                     8px;
}

prompt {
    background-color:            transparent;
    text-color:                  @border-col; /* Blue Magnifying Glass Icon */
    font:                        "Arimo Nerd Font Bold 13";
}

entry {
    background-color:            transparent;
    text-color:                  @text-col;
    placeholder:                 "Search installed apps...";
    placeholder-color:           @text-muted;
}

/* --- Result Scroll Box Layout --- */
listview {
    background-color:            transparent;
    columns:                     1;
    lines:                       7;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     4px;
}

/* --- Singular App Result Row Layout --- */
element {
    background-color:            transparent;
    text-color:                  @text-col;
    border-radius:               6px;
    padding:                     8px 12px;
    spacing:                     12px;
    cursor:                      pointer;
    orientation:                 horizontal;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @text-col;
}

element selected.normal {
    background-color:            @selected; /* Elegant highlight background highlight */
    text-color:                  @text-col;
    border:                      0px 0px 0px 4px;
    border-color:                @border-col; /* Highlights left strip with an accent bar */
}

/* Application Graphic Icon Layout Dimensions */
element-icon {
    background-color:            transparent;
    size:                        24px;
    cursor:                      inherit;
}

/* Application Output Text Rendering Label */
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
