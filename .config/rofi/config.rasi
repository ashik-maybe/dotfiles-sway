/* ==============================================================================
 * ROFI CATPPUCCIN MOCHA LAUNCHER THEME
 * ============================================================================== */

configuration {
    modi:                       "drun,run,window";
    show-icons:                 true;
    display-drun:               " ";
    display-run:                " ";
    display-window:             " ";
    drun-format:                "{name}";
    drun-match-fields:          "name,generic,exec,categories,keywords";
    font:                       "Arimo Nerd Font Bold 11";
    sort:                       true;
    case-sensitive:             false;
    /* icon-theme:                 "Papirus-Dark"; */

    kb-mode-next:               "Shift+Right,Control+Tab";
    kb-mode-previous:           "Shift+Left,Control+ISO_Left_Tab";
    kb-accept-custom:           "Control+Return";
    kb-remove-to-first:         "Control+BackSpace,Control+w";
    kb-row-up:                  "Up,Control+p,Shift+Tab";
    kb-row-down:                "Down,Control+n";
}

/* --- Catppuccin Mocha Color Variables --- */
* {
    rosewater: #f5e0dc;
    flamingo:  #f2cdcd;
    pink:      #f5c2e7;
    mauve:     #cba6f7;
    red:       #f38ba8;
    maroon:    #eba0ac;
    peach:     #fab387;
    yellow:    #f9e2af;
    green:     #a6e3a1;
    teal:      #94e2d5;
    sky:       #89dceb;
    sapphire:  #74c7ec;
    blue:      #89b4fa;
    lavender:  #b4befe;
    text:      #cdd6f4;
    subtext1:  #bac2de;
    subtext0:  #a6adc8;
    overlay2:  #9399b2;
    overlay1:  #7f849c;
    overlay0:  #6c7086;
    surface2:  #585b70;
    surface1:  #45475a;
    surface0:  #313244;
    base:      #1e1e2e;
    mantle:    #181825;
    crust:     #11111b;

    width: 600;
    background-color: transparent;
}

/* Window */
window {
    height:                      400px;
    border:                      2px;
    border-color:                @blue;
    border-radius:               12px;
    background-color:            @crust;
    text-color:                  @text;
}

/* Main box */
mainbox {
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
    padding:                     16px;
    spacing:                     12px;
}

/* --- Top Row Search Bar Wrapper --- */
inputbar {
    background-color:            @base;
    text-color:                  @text;
    border-radius:               8px;
    padding:                     10px 14px;
    children:                    [ "prompt", "entry" ];
    spacing:                     8px;
}

prompt {
    background-color:            transparent;
    text-color:                  @blue;
    font:                        "Arimo Nerd Font Bold 13";
}

entry {
    background-color:            transparent;
    text-color:                  @text;
    placeholder:                 "Search installed apps...";
    placeholder-color:           @overlay0;
}

/* List view */
listview {
    background-color:            transparent;
    columns:                     1;
    lines:                       7;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     4px;
}

/* Element */
element {
    background-color:            transparent;
    text-color:                  @text;
    border-radius:               6px;
    padding:                     8px 12px;
    spacing:                     12px;
    cursor:                      pointer;
    orientation:                 horizontal;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @text;
}

element selected.normal {
    background-color:            @surface0;
    text-color:                  @text;
    border:                      0px 0px 0px 4px;
    border-color:                @blue;
}

element urgent.normal {
    background-color:            @crust;
    text-color:                  @red;
    border:                      0px 0px 0px 4px;
    border-color:                @red;
}

/* Icon */
element-icon {
    background-color:            transparent;
    size:                        24px;
    cursor:                      inherit;
}

/* Text */
element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
