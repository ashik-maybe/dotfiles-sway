configuration {
    modi: "drun,run,window,combi";
    show-icons: true;
    display-drun: " ";
    display-run: " ";
    display-window: " ";
    display-combi: " ";
    font: "IntoneMono Nerd Font Bold 11";
    sort: true;
    case-sensitive: false;
    kb-mode-next: "Shift+Right,Control+Tab";
    kb-mode-previous: "Shift+Left,Control+ISO_Left_Tab";
    kb-accept-custom: "Control+Return";
    kb-row-up: "Up,Control+p,Shift+Tab";
    kb-row-down: "Down,Control+n";
}
* {
    191724: #191724; 1F1D2E: #1F1D2E; 26233A: #26233A; 6E6A86: #6E6A86;
    E0DEF4: #E0DEF4; E0DEF4: #E0DEF4; E0DEF4: #E0DEF4;
    9CCFD8: #9CCFD8; 9CCFD8: #9CCFD8; EB6F92: #EB6F92; C4A7E7: #C4A7E7;
    C4A7E7: #C4A7E7; 9CCFD8: #9CCFD8; F6C177: #F6C177; EBBCBA: #EBBCBA; EB6F92: #EB6F92;
    width: 600; background-color: transparent;
}
window { height: 400px; border: 2px; border-color: @EB6F92; border-radius: 12px; background-color: @191724; text-color: @E0DEF4; }
mainbox { background-color: transparent; children: [ "inputbar", "listview" ]; padding: 16px; spacing: 12px; }
inputbar { background-color: @1F1D2E; text-color: @E0DEF4; border-radius: 8px; padding: 10px 14px; children: [ "prompt", "entry" ]; spacing: 8px; }
prompt { background-color: transparent; text-color: @EB6F92; font: "IntoneMono Nerd Font Bold 13"; }
entry { background-color: transparent; text-color: @E0DEF4; placeholder: "Regolith Launcher..."; placeholder-color: @6E6A86; }
listview { background-color: transparent; columns: 1; lines: 7; cycle: true; dynamic: true; scrollbar: false; layout: vertical; fixed-height: true; spacing: 4px; }
element { background-color: transparent; text-color: @E0DEF4; border-radius: 6px; padding: 8px 12px; spacing: 12px; cursor: pointer; orientation: horizontal; }
element selected.normal { background-color: @26233A; border: 0px 0px 0px 4px; border-color: @EB6F92; }
element-icon { background-color: transparent; size: 24px; }
element-text { background-color: transparent; text-color: inherit; vertical-align: 0.5; }
