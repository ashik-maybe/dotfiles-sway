configuration {
    modi: "drun,run,window,combi";
    show-icons: true;
    display-drun: " ";
    display-run: " ";
    display-window: " ";
    display-combi: " ";
    font: "JetBrainsMono Nerd Font Bold 11";
    sort: true;
    case-sensitive: false;
    kb-mode-next: "Shift+Right,Control+Tab";
    kb-mode-previous: "Shift+Left,Control+ISO_Left_Tab";
    kb-accept-custom: "Control+Return";
    kb-row-up: "Up,Control+p,Shift+Tab";
    kb-row-down: "Down,Control+n";
}
* {
    nord0: #2E3440; nord1: #3B4252; nord2: #434C5E; nord3: #4C566A;
    nord4: #D8DEE9; nord5: #E5E9F0; nord6: #ECEFF4;
    nord8: #8FBCBB; nord9: #88C0D0; nord10: #81A1C1; nord11: #5E81AC;
    nord12: #B48EAD; nord13: #A3BE8C; nord14: #EBCB8B; nord15: #D08770; nord16: #BF616A;
    width: 600; background-color: transparent;
}
window { height: 400px; border: 2px; border-color: @nord10; border-radius: 12px; background-color: @nord0; text-color: @nord4; }
mainbox { background-color: transparent; children: [ "inputbar", "listview" ]; padding: 16px; spacing: 12px; }
inputbar { background-color: @nord1; text-color: @nord4; border-radius: 8px; padding: 10px 14px; children: [ "prompt", "entry" ]; spacing: 8px; }
prompt { background-color: transparent; text-color: @nord10; font: "JetBrainsMono Nerd Font Bold 13"; }
entry { background-color: transparent; text-color: @nord4; placeholder: "Regolith Launcher..."; placeholder-color: @nord3; }
listview { background-color: transparent; columns: 1; lines: 7; cycle: true; dynamic: true; scrollbar: false; layout: vertical; fixed-height: true; spacing: 4px; }
element { background-color: transparent; text-color: @nord4; border-radius: 6px; padding: 8px 12px; spacing: 12px; cursor: pointer; orientation: horizontal; }
element selected.normal { background-color: @nord2; border: 0px 0px 0px 4px; border-color: @nord10; }
element-icon { background-color: transparent; size: 24px; }
element-text { background-color: transparent; text-color: inherit; vertical-align: 0.5; }
