[global]
    ### Geometry
    monitor = 0
    follow = mouse
    width = 320
    height = 200
    origin = top-right
    offset = 12x45
    scale = 1

    # Behavior
    notification_limit = 4
    direction = down
    fixed_hz_order = true
    stack_duplicates = true
    history_length = 20

    # Progress bar
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    highlight = #89b4fa

    ### Aesthetics
    transparency = 0
    gap_size = 4
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2
    frame_color = #89b4fa
    separator_color = frame
    corner_radius = 8

    ### Typography
    font = Arimo Nerd Font 10
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = true
    ignore_newline = true

    ### Icon lookup
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    ### Mouse
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# --- Urgency levels ---

[urgency_low]
    background = #1e1e2e
    foreground = #cdd6f4
    frame_color = #45475a
    timeout = 4

[urgency_normal]
    background = #1e1e2e
    foreground = #cdd6f4
    frame_color = #89b4fa
    timeout = 6

[urgency_critical]
    background = #1e1e2e
    foreground = #f38ba8
    frame_color = #fab387
    timeout = 0

[shortcuts]
    close = Ctrl+Shift+d
    close_all = Ctrl+Shift+x
    history = Ctrl+Shift+h
    context = Ctrl+Shift+period
