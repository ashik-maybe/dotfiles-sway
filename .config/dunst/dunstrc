[global]
    ### Display & Geometry Layout
    monitor = 0
    follow = mouse
    width = 320
    height = 200
    origin = top-right
    offset = 12x45 # Safely clears your top Waybar padding
    scale = 1

    # Appearance Rules
    notification_limit = 4
    direction = down
    fixed_hz_order = true

    # Progress bar setups (Volume/Brightness indicators)
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    ### Aesthetics & Frame Styles
    transparency = 0
    gap_size = 4
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 10
    frame_width = 2
    frame_color = #89b4fa     # Catppuccin Blue Accent Frame
    separator_color = #313244 # Slate Split Line
    corner_radius = 8

    ### Typography Configuration
    font = Arimo Nerd Font 10
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b" # Bold Title, standard body content
    alignment = left
    show_age_threshold = 60
    word_wrap = true

    ### System Icons Strategy (Fedora Default Fallbacks)
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    ### Mouse & Interaction Mappings
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# --- Urgency Color Mappings (Catppuccin Midnight Theme) ---

[urgency_low]
    background = #1e1e2e
    foreground = #cdd6f4
    frame_color = #45475a
    timeout = 4

[urgency_normal]
    background = #1e1e2e
    foreground = #cdd6f4
    frame_color = #89b4fa
    timeout = 6

[urgency_critical]
    background = #1e1e2e
    foreground = #f38ba8 # Flashes alert pink
    frame_color = #f38ba8
    timeout = 0 # Sticky: Must be dismissed manually
